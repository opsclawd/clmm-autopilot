# Devnet E2E harness inputs
# Copy to .env and adjust as needed.
RPC_URL=https://api.devnet.solana.com
AUTHORITY_KEYPAIR=./keys/devnet-authority.json
LOCAL_RECEIPT_DB_PATH=./artifacts/devnet/local-receipts.db
ONCHAIN_RECEIPT_ENABLED=1

# Provide either a single position address or a comma-separated candidate list.
POSITION_ADDRESS=5jERdji9US1EzBinbe3U3mzbxrPxvjdAZFB9NQrxduR3
POSITION_ADDRESS_CANDIDATES=
WALLET_ADDRESS=6dYHEUMcmuyYUokrfvM2Cci4zK7wSjKS8J8Zk274mABn
SWAP_ROUTER=noop
FORCE_DECISION=
REQUIRE_RECEIPT_PROOF=0
RECEIPT_IDENTITY_SOURCE=
# Optional advanced override for receipt manifest-driven identity resolution.
RECEIPT_MANIFEST_PATH=

